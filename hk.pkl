amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

local lint_steps = new Mapping<String, Step> {
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["python-syntax"] = new Step {
    glob = "**/*.py"
    check = "python3 -m py_compile {{files}}"
  }
  ["skills"] = new Step {
    glob = List("skills/**", "**/*.md")
    check = "python3 scripts/check.py scripts/check_skills.py"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps = lint_steps
  }
  ["check"] {
    steps = lint_steps
  }
  ["pre-push"] {
    steps {
      ["checks"] {
        env {
          ["CHECK_CHANGED_SINCE"] = "origin/main"
          ["CHECK_PUSH_REFS"] = "{{hook_stdin}}"
        }
        check = "python3 scripts/check.py"
      }
    }
  }
}
