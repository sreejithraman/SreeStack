{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sreestack:showroom:delivery-result:v1",
  "title": "Showroom delivery result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "surface",
    "operation",
    "verification",
    "location",
    "evidence_paths",
    "log_paths",
    "availability_limitations"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "surface": { "enum": ["device", "testflight"] },
    "operation": { "enum": ["start", "verify"] },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail", "checks"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "detail": { "type": "string" },
        "checks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/status" }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "anyOf": [
        { "required": ["url"], "properties": { "url": { "type": "string", "minLength": 1 } } },
        { "required": ["device"], "properties": { "device": { "type": "string", "minLength": 1 } } },
        { "required": ["artifact"], "properties": { "artifact": { "type": "string", "minLength": 1 } } },
        { "required": ["command"], "properties": { "command": { "$ref": "#/$defs/argv" } } }
      ],
      "properties": {
        "url": { "type": ["string", "null"], "minLength": 1 },
        "device": { "type": ["string", "null"], "minLength": 1 },
        "artifact": { "type": ["string", "null"], "minLength": 1 },
        "command": { "oneOf": [{ "$ref": "#/$defs/argv" }, { "type": "null" }] }
      }
    },
    "provider": { "type": ["string", "null"], "minLength": 1 },
    "provider_resource_id": { "type": ["string", "null"], "minLength": 1 },
    "evidence_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "log_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "availability_limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "surface": { "const": "device" } } },
      "then": {
        "properties": {
          "location": {
            "required": ["device"],
            "properties": { "device": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "surface": { "const": "testflight" } } },
      "then": {
        "properties": {
          "location": {
            "required": ["url"],
            "properties": { "url": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  ],
  "$defs": {
    "status": { "enum": ["pending", "passed", "failed", "blocked", "stale"] },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
