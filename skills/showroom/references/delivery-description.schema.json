{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sreestack:showroom:delivery-description:v1",
  "title": "Showroom delivery description",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "surfaces"],
  "properties": {
    "protocol_version": { "const": 1 },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "device": { "$ref": "#/$defs/surface" },
        "testflight": { "$ref": "#/$defs/surface" }
      }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "verify", "lifecycle_owner", "required_arguments"],
      "properties": {
        "start": { "$ref": "#/$defs/argv" },
        "verify": { "$ref": "#/$defs/argv" },
        "lifecycle_owner": { "enum": ["manual", "provider"] },
        "provider": { "type": "string", "minLength": 1 },
        "required_arguments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$" }
        }
      }
    }
  }
}
