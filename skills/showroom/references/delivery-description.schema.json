{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sreestack:showroom:delivery-description:v1",
  "title": "Showroom delivery description",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "surfaces"],
  "properties": {
    "protocol_version": { "const": 1 },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "device": { "$ref": "#/$defs/device" },
        "testflight": { "$ref": "#/$defs/testflight" }
      }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "credentials": {
      "type": "array",
      "uniqueItems": true,
      "items": { "const": "apple" },
      "maxItems": 1
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "verify", "lifecycle_owner", "required_arguments"],
      "properties": {
        "start": { "$ref": "#/$defs/argv" },
        "verify": { "$ref": "#/$defs/argv" },
        "lifecycle_owner": { "const": "manual" },
        "start_credentials": { "$ref": "#/$defs/credentials" },
        "verify_credentials": { "$ref": "#/$defs/credentials" },
        "required_arguments": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "testflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "verify", "lifecycle_owner", "provider", "required_arguments"],
      "properties": {
        "start": { "$ref": "#/$defs/argv" },
        "verify": { "$ref": "#/$defs/argv" },
        "lifecycle_owner": { "const": "provider" },
        "provider": { "type": "string", "minLength": 1 },
        "start_credentials": { "$ref": "#/$defs/credentials" },
        "verify_credentials": { "$ref": "#/$defs/credentials" },
        "required_arguments": {
          "const": ["build-number"]
        }
      }
    }
  }
}
