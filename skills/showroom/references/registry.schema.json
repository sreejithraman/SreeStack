{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sreestack:showroom:registry:v1",
  "title": "showroom machine registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "records": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "nullable_timestamp": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "record_version",
        "id",
        "type",
        "adapter",
        "registered",
        "lifecycle_owner",
        "cleanup_policy",
        "profile",
        "status",
        "repository",
        "worktree",
        "surface",
        "resources",
        "verification",
        "evidence_paths",
        "log_paths",
        "timestamps",
        "lease_hours",
        "pinned",
        "availability_limitations",
        "commands"
      ],
      "properties": {
        "record_version": { "const": 1 },
        "id": { "type": "string", "pattern": "^srm_[a-f0-9]{16}$" },
        "type": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "registered": { "type": "boolean" },
        "provider": { "type": ["string", "null"] },
        "provider_resource_id": { "type": ["string", "null"] },
        "lifecycle_owner": { "enum": ["showroom", "provider", "pull-request", "manual"] },
        "cleanup_policy": { "enum": ["lease", "manual", "provider", "pull-request"] },
        "profile": { "type": "string", "minLength": 1 },
        "status": { "enum": ["starting", "active", "stopping", "stopped"] },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "common_directory", "source"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "common_directory": { "type": "string", "minLength": 1 },
            "source": { "type": ["string", "null"] }
          }
        },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "device", "artifact", "command"],
          "properties": {
            "url": { "type": ["string", "null"] },
            "device": { "type": ["string", "null"] },
            "artifact": { "type": ["string", "null"] },
            "command": {
              "oneOf": [
                { "type": "null" },
                { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "process": {},
            "launchd": {},
            "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "simulator_udid": { "type": ["string", "null"] }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checked_at", "detail"],
          "properties": {
            "status": { "enum": ["pending", "passed", "failed", "blocked", "stale"] },
            "checked_at": { "$ref": "#/$defs/nullable_timestamp" },
            "detail": { "type": ["string", "null"] },
            "checks": { "type": "object", "additionalProperties": true }
          }
        },
        "evidence_paths": { "type": "array", "items": { "type": "string" } },
        "log_paths": { "type": "array", "items": { "type": "string" } },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["created_at", "renewed_at", "expires_at"],
          "properties": {
            "created_at": { "$ref": "#/$defs/timestamp" },
            "renewed_at": { "$ref": "#/$defs/timestamp" },
            "expires_at": { "$ref": "#/$defs/nullable_timestamp" }
          }
        },
        "lease_hours": { "type": "number", "exclusiveMinimum": 0 },
        "pinned": { "type": "boolean" },
        "availability_limitations": { "type": "array", "items": { "type": "string" } },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspect", "verify", "renew", "pin", "unpin", "stop"],
          "properties": {
            "inspect": { "type": "string" },
            "verify": { "type": "string" },
            "renew": { "type": "string" },
            "pin": { "type": "string" },
            "unpin": { "type": "string" },
            "stop": { "type": "string" }
          }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "started_at", "previous_status"],
          "properties": {
            "kind": { "const": "stop" },
            "started_at": { "$ref": "#/$defs/timestamp" },
            "previous_status": { "enum": ["starting", "active"] }
          }
        }
      }
    }
  }
}
