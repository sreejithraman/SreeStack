{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sreestack:previewctl:manifest:v1",
  "title": "previewctl project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "kind": {
      "enum": [
        "auto",
        "web",
        "ios",
        "android",
        "desktop",
        "api",
        "cli",
        "library",
        "infrastructure",
        "data",
        "evidence"
      ],
      "default": "auto"
    },
    "working_directory": { "type": "string", "minLength": 1, "default": "." },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "port": {
      "oneOf": [
        { "const": "auto" },
        { "type": "integer", "minimum": 1024, "maximum": 65535 }
      ],
      "default": "auto"
    },
    "health_check_path": { "type": "string", "pattern": "^/", "default": "/" },
    "hosted_provider": { "type": "string", "minLength": 1 },
    "privacy": {
      "enum": ["private", "tailnet", "public-requires-approval"],
      "default": "tailnet"
    },
    "profile": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "default": "default" },
    "lease_hours": { "type": "number", "exclusiveMinimum": 0, "default": 24 },
    "cleanup_policy": {
      "enum": ["lease", "provider", "pull-request", "pr", "manual"],
      "default": "lease"
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "enum": ["http", "screenshot", "recording", "transcript", "artifact", "report"]
      },
      "uniqueItems": true,
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {
        "enum": ["http", "screenshot", "recording", "transcript", "artifact", "report"]
      },
      "uniqueItems": true
    },
    "cleanup": {
      "enum": ["lease", "provider", "pull-request", "pr", "manual"]
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "workspace": { "type": "string", "minLength": 1 },
        "scheme": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1, "default": "Debug" },
        "device": { "type": "string", "minLength": 1 },
        "device_type_identifier": { "type": "string", "minLength": 1 },
        "runtime_identifier": { "type": "string", "minLength": 1 },
        "deep_link": { "type": "string", "minLength": 1 },
        "launch_arguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "fixture": { "type": "string", "minLength": 1 },
        "recording": { "type": "boolean", "default": false },
        "recording_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 5 }
      },
      "allOf": [
        { "not": { "required": ["project", "workspace"] } }
      ]
    }
  }
}
