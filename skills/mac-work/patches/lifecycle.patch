+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SreeStack contributors.
+"""Local lifecycle repair; admission and FIFO remain in queue_core.
+
+The process-group contract covers only members of the launched session group.
+Uncontained commands retain capacity until a changed boot proves closure.
+"""
+
+import ctypes
+import errno
+import hashlib
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import uuid
+
+
+class BSDInfo(ctypes.Structure):
+    _fields_ = [(name, ctypes.c_uint32) for name in (
+        'flags', 'status', 'xstatus', 'pid', 'ppid', 'uid', 'gid', 'ruid',
+        'rgid', 'svuid', 'svgid', 'reserved')]
+    _fields_ += [('comm', ctypes.c_char * 16), ('name', ctypes.c_char * 32)]
+    _fields_ += [(name, ctypes.c_uint32) for name in ('nfiles', 'pgid', 'jobc', 'tdev', 'tpgid')]
+    _fields_ += [('nice', ctypes.c_int32), ('seconds', ctypes.c_uint64), ('microseconds', ctypes.c_uint64)]
+
+
+def boot_identity():
+    if sys.platform != 'darwin':
+        raise RuntimeError('This local lifecycle repair is qualified only for macOS')
+    value = subprocess.check_output(['/usr/sbin/sysctl', '-n', 'kern.bootsessionuuid'],
+                                    text=True, timeout=5).strip()
+    return str(uuid.UUID(value))
+
+
+def process_identity(pid):
+    library = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)
+    data = BSDInfo()
+    ctypes.set_errno(0)
+    count = library.proc_pidinfo(int(pid), 3, 0, ctypes.byref(data), ctypes.sizeof(data))
+    if count != ctypes.sizeof(data):
+        if ctypes.get_errno() == errno.ESRCH:
+            return None
+        raise RuntimeError(f'Cannot establish birth identity for PID {pid}')
+    return {'pid': data.pid, 'pgid': data.pgid, 'birth': [data.seconds, data.microseconds],
+            'zombie': data.status == 5}
+
+
+def group_members(group):
+    result = subprocess.run(['/bin/ps', '-axo', 'pid=,pgid='], capture_output=True,
+                            text=True, check=True, timeout=5)
+    members = []
+    for line in result.stdout.splitlines():
+        pid, pgid = map(int, line.split())
+        if pgid == group:
+            item = process_identity(pid)
+            if item is not None and item['pgid'] == group and not item['zombie']:
+                members.append(item)
+    return members
+
+
+def schema(conn):
+    columns = {row[1] for row in conn.execute('PRAGMA table_info(queue)')}
+    if 'lifecycle_json' not in columns:
+        conn.execute('ALTER TABLE queue ADD COLUMN lifecycle_json TEXT')
+    conn.execute('CREATE TABLE IF NOT EXISTS admission_policy (singleton INTEGER PRIMARY KEY CHECK(singleton=1), policy_json TEXT NOT NULL)')
+
+
+def validate_state(conn):
+    required = {
+        'queue': {'id', 'queue_name', 'status', 'pid', 'server_id', 'child_pid', 'command',
+                  'working_directory', 'worktree_root', 'repo_name', 'git_branch',
+                  'agent_name', 'created_at', 'updated_at', 'lifecycle_json'},
+        'task_results': {'task_id', 'result_json', 'completed_at'},
+        'task_operations': {'operation_id', 'request_json', 'request_sha256', 'task_id',
+                            'configuration_sha256', 'worker_json'},
+        'admission_policy': {'singleton', 'policy_json'},
+    }
+    for table, columns in required.items():
+        existing = {row[1] for row in conn.execute('PRAGMA table_info(' + table + ')')}
+        if not columns <= existing:
+            raise ValueError('Shared admission schema missing/incompatible: ' + table + '; restore state, never reinitialize')
+    rows = conn.execute('SELECT singleton, policy_json FROM admission_policy').fetchall()
+    if len(rows) != 1 or rows[0][0] != 1:
+        raise ValueError('Shared admission policy missing/incompatible; restore state')
+    policy = json.loads(rows[0][1])
+    if (policy.get('schema') != 1 or not policy.get('capacities')
+            or policy.get('ownership_contract') not in {'uncontained', 'process-group'}):
+        raise ValueError('Shared admission policy missing/incompatible; restore state')
+
+
+def configure(conn, capacities, contract, *, initialize=False):
+    if contract not in {'uncontained', 'process-group'}:
+        raise ValueError('Unknown ownership contract')
+    if not capacities:
+        raise ValueError('An explicit root --queue-capacity is required')
+    policy = json.dumps({'schema': 1, 'capacities': capacities, 'ownership_contract': contract}, sort_keys=True)
+    if initialize:
+        conn.execute('INSERT INTO admission_policy VALUES (1, ?)', (policy,))
+    else:
+        validate_state(conn)
+    existing = conn.execute('SELECT policy_json FROM admission_policy WHERE singleton=1').fetchone()[0]
+    if policy != existing:
+        raise ValueError('Shared admission configuration mismatch; use the original capacities and ownership contract')
+    conn.commit()
+
+
+def new_task(conn, task_id, owner_pid):
+    policy = conn.execute('SELECT policy_json FROM admission_policy WHERE singleton=1').fetchone()
+    if policy is None:
+        raise RuntimeError('Admission policy is missing; configure before submitting')
+    row = conn.execute('SELECT queue_name FROM queue WHERE id=?', (task_id,)).fetchone()
+    value = json.loads(policy[0])
+    if not any(row['queue_name'] == root or row['queue_name'].startswith(root + '/') for root in value['capacities']):
+        raise ValueError('Queue is outside the configured admission roots')
+    metadata = {'schema': 1, 'generation': str(uuid.uuid4()), 'boot': boot_identity(),
+                'owner': process_identity(owner_pid), 'state': 'waiting',
+                'ownership_contract': value['ownership_contract'],
+                'config_sha256': hashlib.sha256(policy[0].encode()).hexdigest()}
+    conn.execute('UPDATE queue SET lifecycle_json=? WHERE id=?', (json.dumps(metadata), task_id))
+
+
+def limits(conn, task_id, execution_seconds, queue_seconds):
+    row = conn.execute('SELECT lifecycle_json, working_directory FROM queue WHERE id=?', (task_id,)).fetchone()
+    meta = json.loads(row['lifecycle_json'])
+    meta.update(execution_seconds=execution_seconds, queue_seconds=queue_seconds,
+                queue_deadline=time.time() + queue_seconds if queue_seconds is not None else None)
+    if row['working_directory']:
+        revision = subprocess.run(['git', '-C', row['working_directory'], 'rev-parse', 'HEAD'],
+                                  text=True, capture_output=True, timeout=5)
+        meta['revision'] = revision.stdout.strip() if revision.returncode == 0 else None
+    conn.execute('UPDATE queue SET lifecycle_json=? WHERE id=?', (json.dumps(meta), task_id))
+    conn.commit()
+
+
+def admitted(conn, task_id):
+    """Called only within upstream's successful waiting-to-running transaction."""
+    row = conn.execute('SELECT lifecycle_json FROM queue WHERE id=?', (task_id,)).fetchone()
+    metadata = json.loads(row[0])
+    now = time.time()
+    if metadata.get('queue_deadline') is not None and now >= metadata['queue_deadline']:
+        raise TimeoutError('Queue wait deadline expired before admission')
+    metadata.update(state='admitted', admitted_at=now,
+                    execution_deadline=now + metadata['execution_seconds'])
+    conn.execute('UPDATE queue SET lifecycle_json=? WHERE id=?', (json.dumps(metadata), task_id))
+
+
+def launch_metadata(conn, task_id, generation=None):
+    row = conn.execute('SELECT * FROM queue WHERE id=?', (task_id,)).fetchone()
+    if row is None:
+        raise RuntimeError('Command no longer active before gated launch')
+    metadata = json.loads(row['lifecycle_json'])
+    if metadata.get('result') or row['status'] != 'running':
+        raise RuntimeError('Command cancelled before gated launch')
+    if (generation is not None and metadata['generation'] != generation
+            or row['pid'] != os.getpid()
+            or metadata['owner'] != process_identity(os.getpid())
+            or metadata['boot'] != boot_identity()):
+        raise RuntimeError('Command launch owner/generation mismatch')
+    if time.time() >= metadata['execution_deadline']:
+        raise TimeoutError('Execution deadline expired before gated launch')
+    return metadata
+
+
+def recorded_child(conn, task_id, pid, generation):
+    identity = process_identity(pid)
+    if identity is None or identity['pgid'] != pid:
+        raise RuntimeError('Cannot establish launched process group identity')
+    conn.execute('BEGIN IMMEDIATE')
+    try:
+        metadata = launch_metadata(conn, task_id, generation)
+        metadata.update(state='executing', child=identity, launched_at=time.time())
+        conn.execute('UPDATE queue SET child_pid=?, lifecycle_json=? WHERE id=?',
+                     (pid, json.dumps(metadata), task_id))
+        conn.commit()
+    except BaseException:
+        conn.rollback()
+        raise
+
+
+def release_gate(conn, task_id, generation, write_fd):
+    # Identity is durable before the gate opens; cancellation serializes here too.
+    conn.execute('BEGIN IMMEDIATE')
+    try:
+        launch_metadata(conn, task_id, generation)
+        os.write(write_fd, b'1')
+        conn.commit()
+    except BaseException:
+        conn.rollback()
+        raise
+
+
+def gate_arguments(command, read_fd):
+    return [sys.executable, '-I', __file__, '--gate', str(read_fd), command]
+
+
+def launch(conn, task_id, command, **kwargs):
+    generation = launch_metadata(conn, task_id)['generation']
+    read_fd, write_fd = os.pipe()
+    child = None
+    opened = False
+    try:
+        child = subprocess.Popen(gate_arguments(command, read_fd), pass_fds=(read_fd,),
+                                 start_new_session=True, **kwargs)
+        recorded_child(conn, task_id, child.pid, generation)
+        release_gate(conn, task_id, generation, write_fd)
+        opened = True
+        return child
+    finally:
+        os.close(read_fd)
+        os.close(write_fd)
+        if child is not None and not opened:
+            child.wait(timeout=5)
+
+
+async def launch_async(conn, task_id, command, **kwargs):
+    import asyncio
+    generation = launch_metadata(conn, task_id)['generation']
+    read_fd, write_fd = os.pipe()
+    child = None
+    opened = False
+    try:
+        child = await asyncio.create_subprocess_exec(*gate_arguments(command, read_fd),
+                    pass_fds=(read_fd,), start_new_session=True, **kwargs)
+        recorded_child(conn, task_id, child.pid, generation)
+        release_gate(conn, task_id, generation, write_fd)
+        opened = True
+        return child
+    finally:
+        os.close(read_fd)
+        os.close(write_fd)
+        if child is not None and not opened:
+            await asyncio.wait_for(child.wait(), timeout=5)
+
+
+def receipt(conn, row, metadata, result, pending):
+    value = {'task_id': row['id'], 'command': row['command'], 'queue_name': row['queue_name'],
+             'working_directory': row['working_directory'], 'worktree_root': row['worktree_root'],
+             'agent_name': row['agent_name'], 'created_at': row['created_at'], 'output_file': None, 'tail': None, 'exit_code': None, **result,
+             'lifecycle': metadata, 'capacity_held': pending}
+    if pending:
+        value['intended_status'] = result['status']
+        value['status'] = 'recovery-pending'
+        value['reason'] = metadata['reason']
+    else:
+        value['closed_at'] = time.time()
+    conn.execute('INSERT INTO task_results(task_id,result_json) VALUES (?,?) ON CONFLICT(task_id) DO UPDATE SET result_json=excluded.result_json',
+                 (row['id'], json.dumps(value)))
+    return value
+
+
+def close_task(conn, task_id, result=None, terminate=False, reason='closure_requested'):
+    """One durable closure route; an uncertain row always remains running."""
+    if conn.in_transaction:
+        conn.commit()
+    conn.execute('BEGIN IMMEDIATE')
+    try:
+        row = conn.execute('SELECT * FROM queue WHERE id=?', (task_id,)).fetchone()
+        if row is None:
+            stored = conn.execute('SELECT result_json FROM task_results WHERE task_id=?', (task_id,)).fetchone()
+            conn.commit()
+            return json.loads(stored[0]) if stored else None
+        metadata = json.loads(row['lifecycle_json']) if row['lifecycle_json'] else {}
+        target = metadata.get('result') or result or {'status': 'cancelled' if row['status'] == 'waiting' else 'interrupted', 'duration_seconds': 0.0}
+        metadata.update(result=target, reason=reason, state='closing')
+        receipt(conn, row, metadata, target, True)
+        conn.execute('UPDATE queue SET lifecycle_json=? WHERE id=?', (json.dumps(metadata), task_id))
+        conn.commit()
+        conn.execute('BEGIN IMMEDIATE')
+        row = conn.execute('SELECT * FROM queue WHERE id=?', (task_id,)).fetchone()
+        if row is None:
+            conn.commit()
+            return read_task(conn, task_id)
+        metadata = json.loads(row['lifecycle_json'])
+        target = metadata['result']
+        closed = row['status'] == 'waiting'
+        if metadata.get('boot') and metadata['boot'] != boot_identity():
+            closed = True
+            metadata['reason'] = 'previous_boot_closed'
+        elif row['status'] != 'waiting' and metadata.get('child'):
+            try:
+                child = metadata['child']
+                members = group_members(child['pgid'])
+                anchor = process_identity(child['pid'])
+                anchor_valid = anchor is not None and anchor['birth'] == child['birth'] and anchor['pgid'] == child['pgid']
+                if terminate and members:
+                    # A live birth-verified anchor proves which existing group may be signalled.
+                    known = {m['pid']: m['birth'] for m in members} if anchor_valid else {}
+                    for sig, grace in ((signal.SIGTERM, .25), (signal.SIGKILL, .5)):
+                        if not members:
+                            break
+                        if not any(m['pid'] in known and m['birth'] == known[m['pid']] for m in members):
+                            break
+                        os.killpg(child['pgid'], sig)
+                        end = time.monotonic() + grace
+                        while time.monotonic() < end:
+                            members = group_members(child['pgid'])
+                            if not members:
+                                break
+                            time.sleep(.025)
+                closed = not members and metadata.get('ownership_contract') == 'process-group'
+                if not closed:
+                    metadata['reason'] = 'uncontained_descendants_unprovable' if metadata.get('ownership_contract') != 'process-group' else 'group_closure_unproved'
+            except (OSError, RuntimeError, subprocess.SubprocessError):
+                closed = False
+                metadata['reason'] = 'identity_or_group_observation_unavailable'
+        if closed:
+            metadata['state'] = 'closed'
+            value = receipt(conn, row, metadata, target, False)
+            conn.execute('DELETE FROM queue WHERE id=?', (task_id,))
+        else:
+            metadata['state'] = 'recovery-pending'
+            conn.execute("UPDATE queue SET status='running', lifecycle_json=? WHERE id=?", (json.dumps(metadata), task_id))
+            value = receipt(conn, row, metadata, target, True)
+        conn.commit()
+        return value
+    except Exception:
+        conn.rollback()
+        raise
+
+
+def read_task(conn, task_id):
+    result = conn.execute('SELECT result_json FROM task_results WHERE task_id=?', (task_id,)).fetchone()
+    if result:
+        return json.loads(result[0])
+    row = conn.execute('SELECT * FROM queue WHERE id=?', (task_id,)).fetchone()
+    if row is None:
+        return {'task_id': task_id, 'status': 'unknown'}
+    metadata = json.loads(row['lifecycle_json']) if row['lifecycle_json'] else {}
+    return {'task_id': task_id, 'status': 'queued' if row['status'] == 'waiting' else 'running',
+            'command': row['command'], 'lifecycle': metadata, 'capacity_held': row['status'] == 'running'}
+
+
+def reconcile(conn, queue_name, max_age_minutes, server_id=None):
+    rows = conn.execute('SELECT * FROM queue WHERE queue_name=?', (queue_name,)).fetchall()
+    for row in rows:
+        meta = json.loads(row['lifecycle_json']) if row['lifecycle_json'] else {}
+        try:
